# Project
PROJECT_NAME=my_app

# Database
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=app_db
DATABASE_URL="postgresql://admin:change_this_password@localhost:5432/app_db?schema=public"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# AI — change AI_PROVIDER to switch vendors, no code changes needed
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
GOOGLE_AI_API_KEY=AIza...
ANTHROPIC_API_KEY=sk-ant-...

# App
PORT=3000
NODE_ENV=development
